{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=medialibrary.db"
  },
  "Telegram": {
    "BotToken": "set-in-user-secrets",
    "InitDataMaxAgeMinutes": 1440
  },
  "Jwt": {
    "Issuer": "MediaLibrary.Api",
    "Audience": "MediaLibrary.Bot",
    "Secret": "",
    "ExpiresHours": 24
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 0,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "AuthQueueLimit": 0,
    "BotAuthPermitLimit": 100,
    "BotAuthWindowSeconds": 60,
    "BotAuthQueueLimit": 0
  }
}
