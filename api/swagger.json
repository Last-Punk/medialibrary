  "paths": {
    "/api/auth/telegram": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate a Telegram Web App user",
        "description": "Validates Telegram Web App initData and returns the user's API JWT.",
        "operationId": "AuthenticateTelegram",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelegramAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/bot": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate a Telegram user through the trusted bot server",
        "description": "Requires the private X-Bot-Api-Key header and a Telegram user ID from a verified Telegram update.",
        "operationId": "AuthenticateBotServerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BotAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "BotApiKey": [ ]
          }
        ]
      }
    },
